# Copy this file to .env. Separate variables safely support special characters
# in your PostgreSQL password (including @). Never commit your real .env file.
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Ateeb

# Generate a private random key before deployment.
SECRET_KEY=replace_with_a_long_random_secret_key
